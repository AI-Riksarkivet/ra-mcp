{
  "name": "sbl-article-viewer",
  "version": "0.1.0",
  "type": "module",
  "description": "SBL Article Viewer - Svenskt biografiskt lexikon article display",
  "scripts": {
    "build": "tsc --noEmit && cross-env INPUT=mcp-app.html vite build",
    "build:watch": "cross-env INPUT=mcp-app.html vite build --watch",
    "dev": "cross-env NODE_ENV=development cross-env INPUT=mcp-app.html vite build --watch"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.4",
    "svelte": "^5.56.4"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@types/node": "^22.20.0",
    "cross-env": "^10.1.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
